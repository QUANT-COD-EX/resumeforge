# ==========================================
# ResumeForge Vercel Environment Variables
# ==========================================

# Your deployed Vercel URL (set after first deployment)
CLIENT_ORIGIN=https://resumeforge.vercel.app

# Python AI service URL (leave empty to use inline fallback on Vercel)
# Only set if you deploy server-python separately (e.g., Railway)
PYTHON_SERVICE_URL=

# AI API Keys (used by Python serverless functions on Vercel)
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
