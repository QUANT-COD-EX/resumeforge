# ==========================================
# ResumeForge Environment Variables
# ==========================================

# Supabase Credentials (create project at https://supabase.com)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# Client Origin (set after deploying on Vercel)
CLIENT_ORIGIN=https://resumeforge.vercel.app

# AI API Keys (Optional — enables live AI models)
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
